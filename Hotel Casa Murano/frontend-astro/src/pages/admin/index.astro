---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Panel Admin - Hotel Casa Murano" currentSection="inicio">
  <div id="admin-content">
    <div class="msj-cargando flex flex-col items-center justify-center py-20">
      <div class="spinner mb-4"></div>
      <p class="font-sans text-text-muted">Cargando panel...</p>
    </div>
  </div>
</AdminLayout>

<script type="module">
  import { STRAPI_URL } from '../../lib/constants';

  const API = STRAPI_URL;
  let scriptsCargados = new Set();

  function toast(msg, tipo) {
    const c = document.getElementById('toast-container');
    if (!c) return;
    const t = document.createElement('div');
    t.className = 'toast ' + tipo;
    t.textContent = msg;
    c.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3000);
  }

  window.toast = toast;

  function norm(raw) {
    if (!raw || raw.error) return { success: false, datos: [], dato: null };
    if (raw.data == null) return { success: false, datos: [], dato: null };
    if (Array.isArray(raw.data)) return { success: true, datos: raw.data, dato: null, meta: raw.meta };
    return { success: true, datos: [raw.data], dato: raw.data, meta: raw.meta };
  }
  function normUpload(raw) {
    if (Array.isArray(raw) && raw.length > 0) return { success: true, ruta: raw[0].url, id: raw[0].id };
    return { success: false, ruta: '', id: null };
  }
  const apiGet = async (tabla, id, params) => {
    let url = id ? `${API}/api/${tabla}/${id}` : `${API}/api/${tabla}`;
    if (params) url += '?' + new URLSearchParams(params).toString();
    const r = await fetch(url);
    return norm(await r.json());
  };
  const apiPost = async (tabla, data) => {
    const r = await fetch(`${API}/api/${tabla}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data }) });
    return norm(await r.json());
  };
  const apiPut = async (tabla, id, data) => {
    const r = await fetch(`${API}/api/${tabla}/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data }) });
    return norm(await r.json());
  };
  const apiDelete = async (tabla, id) => {
    const r = await fetch(`${API}/api/${tabla}/${id}`, { method: 'DELETE' });
    return norm(await r.json());
  };
  const subirArchivo = async (file) => {
    const fd = new FormData();
    fd.append('files', file);
    const r = await fetch(`${API}/api/upload`, { method: 'POST', body: fd });
    return normUpload(await r.json());
  };
  const imgUrl = (img) => img?.url ? (img.url.startsWith('http') ? img.url : API + img.url) : null;
  const configurarUpload = (inputId, previewId, nombreId, hiddenId) => {
    const input = document.getElementById(inputId);
    const preview = document.getElementById(previewId);
    const nombreEl = document.getElementById(nombreId);
    const hidden = document.getElementById(hiddenId);
    if (!input) return;
    input.addEventListener('change', async () => {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        preview.style.display = 'flex';
        preview.querySelector('img').src = e.target.result;
        nombreEl.textContent = file.name;
        hidden.value = '';
      };
      reader.readAsDataURL(file);
      const res = await subirArchivo(file);
      if (res.success) { preview.querySelector('img').src = res.ruta; hidden.value = String(res.id); }
      else toast('Error al subir la imagen', 'error');
    });
  };
  const mostrarCargando = (el) => { el.innerHTML = '<div class="flex flex-col items-center py-10"><div class="spinner mb-4"></div><p class="font-sans text-text-muted">Cargando...</p></div>'; };
  const filtrarTabla = (seccion) => {
    const input = document.getElementById(seccion + '-buscar');
    if (!input) return;
    const filtro = input.value.toLowerCase();
    const tabla = document.getElementById('tabla-' + seccion);
    if (!tabla) return;
    const filas = tabla.querySelectorAll('tbody tr');
    filas.forEach(row => {
      if (row.querySelector('.vacio')) return;
      row.style.display = row.textContent.toLowerCase().includes(filtro) ? '' : 'none';
    });
  };
  window.filtrarTabla = filtrarTabla;
  window.apiGet = apiGet; window.apiPost = apiPost; window.apiPut = apiPut; window.apiDelete = apiDelete;
  window.subirArchivo = subirArchivo; window.configurarUpload = configurarUpload; window.mostrarCargando = mostrarCargando;

  // --- INICIO DASHBOARD ---
  async function cargarInicio() {
    const content = document.getElementById('admin-content');
    content.innerHTML = `
      <section id="inicio-seccion">
        <h1 class="font-heading text-3xl text-white mb-2">Administrar Inicio</h1>
        <p class="font-sans text-text-muted mb-8">Gestiona el texto de bienvenida, la imagen lateral y el carrusel de fotos del slider.</p>

        <div class="bg-bg-admin rounded-2xl p-6 mb-8">
          <h2 class="font-heading text-xl text-gold mb-6">Contenido de Bienvenida</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Título</label>
              <input type="text" id="bienvenida-titulo" placeholder="Título principal (ej: Bienvenidos)" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" />
            </div>
            <div>
              <label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Subtítulo</label>
              <input type="text" id="bienvenida-subtitulo" placeholder="Subtítulo (ej: Hotel Casa Murano)" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Descripción</label>
              <textarea id="bienvenida-descripcion" placeholder="Descripción de bienvenida" rows="4" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary"></textarea>
            </div>
            <div>
              <label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Despedida</label>
              <input type="text" id="bienvenida-despedida" placeholder="Frase de despedida" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" />
            </div>
            <div>
              <label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Imagen Bienvenida</label>
              <div class="upload-area border-2 border-dashed border-white/20 rounded-xl p-6 text-center cursor-pointer hover:border-primary transition-colors" onclick="document.getElementById('bienvenida-img-input').click()">
                <svg viewBox="0 0 24 24" class="w-10 h-10 fill-text-muted mx-auto mb-2"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                <p class="font-sans text-white text-sm">Haz clic para seleccionar imagen</p>
                <span class="font-sans text-text-muted text-xs">JPG, JPEG, PNG, WEBP</span>
              </div>
              <input type="file" id="bienvenida-img-input" accept="image/*" class="hidden" />
              <div id="bienvenida-img-preview" class="hidden mt-3 flex items-center gap-3 bg-white/5 rounded-lg p-3">
                <img src="" alt="preview" class="w-16 h-16 object-cover rounded" />
                <div class="flex-1"><p id="bienvenida-img-nombre" class="font-sans text-white text-sm"></p></div>
                <button type="button" onclick="removerBienvenidaImg()" class="text-red-400 text-2xl bg-transparent border-none cursor-pointer">&times;</button>
              </div>
              <input type="hidden" id="bienvenida-imagen" />
            </div>
          </div>
        </div>

        <div class="bg-bg-admin rounded-2xl p-6 mb-8">
          <h2 class="font-heading text-xl text-gold mb-4">Slider Carrusel (máx. 5 imágenes)</h2>
          <p class="font-sans text-text-muted text-sm mb-6">Sube hasta 5 imágenes de forma independiente.</p>
          <div id="carrusel-grid" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4"></div>
        </div>

        <button class="bg-primary text-black font-sans font-medium border-none rounded-lg px-6 py-3 cursor-pointer hover:bg-primary-dark transition-colors" onclick="guardarBienvenida()">Guardar</button>
      </section>
    `;
    cargarBienvenida();
  }

  async function cargarBienvenida() {
    const res = await apiGet('bienvenida', null, { populate: 'imagen' });
    if (res.success && res.datos.length > 0) {
      const d = res.datos[0];
      document.getElementById('bienvenida-titulo').value = d.titulo || '';
      document.getElementById('bienvenida-subtitulo').value = d.subtitulo || '';
      document.getElementById('bienvenida-descripcion').value = d.descripcion || '';
      document.getElementById('bienvenida-despedida').value = d.despedida || '';
      const img = d.imagen;
      document.getElementById('bienvenida-imagen').value = img?.id || '';
      if (img?.url) {
        const p = document.getElementById('bienvenida-img-preview');
        p.style.display = 'flex';
        p.querySelector('img').src = imgUrl(img);
        document.getElementById('bienvenida-img-nombre').textContent = img.url.split('/').pop();
      }
    }
    configurarUpload('bienvenida-img-input', 'bienvenida-img-preview', 'bienvenida-img-nombre', 'bienvenida-imagen');
    renderCarruselSlots();
    const slidesRes = await apiGet('slider-inicios', null, { populate: 'imagen', sort: 'orden_slider:asc' });
    if (slidesRes.success && slidesRes.datos.length > 0) {
      slidesRes.datos.filter(s => s.activo).sort((a, b) => (a.orden_slider || 0) - (b.orden_slider || 0)).forEach(s => {
        const pos = s.orden_slider;
        if (pos >= 1 && pos <= 5) {
          const preview = document.getElementById('carrusel-preview-' + pos);
          const nombreEl = document.getElementById('carrusel-nombre-' + pos);
          const hidden = document.getElementById('carrusel-imagen-' + pos);
          const img = s.imagen;
          if (preview && img?.url) {
            preview.style.display = 'flex';
            preview.querySelector('img').src = imgUrl(img);
            nombreEl.textContent = img.url.split('/').pop();
            hidden.value = String(img.id);
          }
        }
      });
    }
  }

  function renderCarruselSlots() {
    const grid = document.getElementById('carrusel-grid');
    grid.innerHTML = '';
    for (let i = 1; i <= 5; i++) {
      const slot = document.createElement('div');
      slot.className = 'bg-white/5 rounded-xl p-4';
      slot.innerHTML = \`
        <span class="font-sans text-white text-sm font-medium block mb-3">Imagen \${i}</span>
        <div class="upload-area border-2 border-dashed border-white/20 rounded-xl p-4 text-center cursor-pointer hover:border-primary transition-colors" onclick="document.getElementById('carrusel-input-\${i}').click()">
          <svg viewBox="0 0 24 24" class="w-8 h-8 fill-text-muted mx-auto mb-1"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
          <p class="font-sans text-white text-xs">Seleccionar</p>
        </div>
        <input type="file" id="carrusel-input-\${i}" accept="image/*" class="hidden" />
        <div id="carrusel-preview-\${i}" class="hidden mt-3">
          <img src="" alt="preview" class="w-full h-20 object-cover rounded-lg" />
          <div class="flex items-center justify-between mt-2">
            <p id="carrusel-nombre-\${i}" class="font-sans text-text-muted text-xs truncate flex-1"></p>
            <button type="button" onclick="removerCarruselImg(\${i})" class="text-red-400 text-lg bg-transparent border-none cursor-pointer ml-2">&times;</button>
          </div>
        </div>
        <input type="hidden" id="carrusel-imagen-\${i}" />
      \`;
      grid.appendChild(slot);
      const input = slot.querySelector('input[type="file"]');
      input.addEventListener('change', ((idx) => {
        return async function () {
          const file = this.files[0];
          if (!file) return;
          const preview = document.getElementById('carrusel-preview-' + idx);
          const nombreEl = document.getElementById('carrusel-nombre-' + idx);
          const hidden = document.getElementById('carrusel-imagen-' + idx);
          const reader = new FileReader();
          reader.onload = function (e) {
            preview.style.display = 'block';
            preview.querySelector('img').src = e.target.result;
            nombreEl.textContent = file.name;
            hidden.value = '';
          };
          reader.readAsDataURL(file);
          const res = await subirArchivo(file);
          if (res.success) { preview.querySelector('img').src = res.ruta; hidden.value = String(res.id); }
          else toast('Error al subir imagen', 'error');
        };
      })(i));
    }
  }

  window.removerCarruselImg = function(pos) {
    const preview = document.getElementById('carrusel-preview-' + pos);
    const nombreEl = document.getElementById('carrusel-nombre-' + pos);
    const hidden = document.getElementById('carrusel-imagen-' + pos);
    const input = document.getElementById('carrusel-input-' + pos);
    if (preview) { preview.style.display = 'none'; preview.querySelector('img').src = ''; }
    if (nombreEl) nombreEl.textContent = '';
    if (hidden) hidden.value = '';
    if (input) input.value = '';
  };

  window.removerBienvenidaImg = function() {
    const preview = document.getElementById('bienvenida-img-preview');
    const nombreEl = document.getElementById('bienvenida-img-nombre');
    const hidden = document.getElementById('bienvenida-imagen');
    const input = document.getElementById('bienvenida-img-input');
    if (preview) { preview.style.display = 'none'; preview.querySelector('img').src = ''; }
    if (nombreEl) nombreEl.textContent = '';
    if (hidden) hidden.value = '';
    if (input) input.value = '';
  };

  window.guardarBienvenida = async function () {
    const imgVal = document.getElementById('bienvenida-imagen').value;
    const data = {
      titulo: document.getElementById('bienvenida-titulo').value,
      subtitulo: document.getElementById('bienvenida-subtitulo').value,
      descripcion: document.getElementById('bienvenida-descripcion').value,
      despedida: document.getElementById('bienvenida-despedida').value,
      imagen: imgVal ? Number(imgVal) : null
    };
    const res = await apiGet('bienvenida');
    let r;
    if (res.success && res.datos.length > 0) {
      r = await apiPut('bienvenida', res.datos[0].id, data);
    } else {
      r = await apiPost('bienvenida', data);
    }
    if (!r.success) { toast('Error al guardar bienvenida', 'error'); return; }

    const slidesRes = await apiGet('slider-inicios');
    const existingSlides = slidesRes.success ? slidesRes.datos : [];
    for (const slide of existingSlides) await apiDelete('slider-inicios', slide.id);

    const slidesToSave = [];
    for (let i = 1; i <= 5; i++) {
      const fileInput = document.getElementById('carrusel-input-' + i);
      const hiddenInput = document.getElementById('carrusel-imagen-' + i);
      const file = fileInput ? fileInput.files[0] : null;
      if (file) {
        const uploadRes = await subirArchivo(file);
        if (uploadRes.success) slidesToSave.push({ imagen: uploadRes.id, orden_slider: i });
      } else if (hiddenInput && hiddenInput.value) {
        slidesToSave.push({ imagen: Number(hiddenInput.value), orden_slider: i });
      }
    }
    for (const slide of slidesToSave) {
      await apiPost('slider-inicios', { titulo: '', descripcion: '', imagen: slide.imagen, orden_slider: slide.orden_slider, activo: 1 });
    }
    toast('Bienvenida guardada', 'exito');
  };

  // Init
  cargarInicio();
</script>
