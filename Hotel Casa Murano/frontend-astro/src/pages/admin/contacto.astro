---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin - Contacto" currentSection="contacto">
  <div id="admin-content"><div class="flex flex-col items-center py-20"><div class="spinner mb-4"></div><p class="font-sans text-text-muted">Cargando...</p></div></div>
</AdminLayout>

<script type="module">
  import { STRAPI_URL } from '../../lib/constants';
  const API = STRAPI_URL;
  const norm = (raw) => {
    if (!raw || raw.error || raw.data == null) return { success: false, datos: [], dato: null };
    if (Array.isArray(raw.data)) return { success: true, datos: raw.data, dato: null };
    return { success: true, datos: [raw.data], dato: raw.data };
  };
  const apiGet = async (t, id) => { const r = await fetch(id ? `${API}/api/${t}/${id}` : `${API}/api/${t}`); return norm(await r.json()); };
  const apiPost = async (t, d) => { const r = await fetch(`${API}/api/${t}`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data:d}) }); return norm(await r.json()); };
  const apiPut = async (t, id, d) => { const r = await fetch(`${API}/api/${t}/${id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data:d}) }); return norm(await r.json()); };
  const toast = (msg, tipo) => { const c = document.getElementById('toast-container'); if(!c) return; const t = document.createElement('div'); t.className='toast '+tipo; t.textContent=msg; c.appendChild(t); setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300)},3000); };
  const mostrarCargando = (el) => { el.innerHTML = '<div class="flex flex-col items-center py-10"><div class="spinner mb-4"></div><p class="font-sans text-text-muted">Cargando...</p></div>'; };

  document.getElementById('admin-content').innerHTML = `
    <section>
      <h1 class="font-heading text-3xl text-white mb-2">Administrar Contacto</h1>
      <p class="font-sans text-text-muted mb-8">Modifica la información de contacto y revisa los mensajes recibidos.</p>

      <div class="bg-bg-admin rounded-2xl p-6 mb-8">
        <h2 class="font-heading text-xl text-gold mb-6">Información de Contacto</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Dirección</label><input type="text" id="contacto-direccion" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" /></div>
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Celular / Teléfono</label><input type="tel" id="contacto-celular" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" /></div>
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Email</label><input type="email" id="contacto-email" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" /></div>
          <div class="md:col-span-2"><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Mapa (iframe)</label><textarea id="contacto-mapa" rows="4" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary"></textarea></div>
          <div class="md:col-span-2"><button class="bg-primary text-black font-sans font-medium border-none rounded-lg px-6 py-3 cursor-pointer hover:bg-primary-dark" onclick="guardarInfoContacto()">Guardar Información</button></div>
        </div>
      </div>

      <h2 class="font-heading text-xl text-gold mb-4">Mensajes Recibidos</h2>
      <div class="overflow-x-auto rounded-xl">
        <table class="w-full admin-table" id="tabla-mensajes">
          <thead><tr>
            <th class="bg-[#1a2330] text-text-muted uppercase text-xs tracking-[1px] p-3 text-left">Nombre</th>
            <th class="bg-[#1a2330] text-text-muted uppercase text-xs tracking-[1px] p-3 text-left">Correo</th>
            <th class="bg-[#1a2330] text-text-muted uppercase text-xs tracking-[1px] p-3 text-left">Teléfono</th>
            <th class="bg-[#1a2330] text-text-muted uppercase text-xs tracking-[1px] p-3 text-left">Mensaje</th>
          </tr></thead>
          <tbody id="mensajes-body"><tr><td colspan="4" class="text-center py-10 font-sans text-text-muted">Cargando...</td></tr></tbody>
        </table>
      </div>
    </section>
  `;
  cargarInfoContacto();
  cargarMensajes();

  async function cargarInfoContacto() {
    const res = await apiGet('informacion-contacto');
    if (res.success && res.datos.length > 0) {
      const d = res.datos[0];
      document.getElementById('contacto-direccion').value = d.direccion || '';
      document.getElementById('contacto-celular').value = d.celular || d.telefono || '';
      document.getElementById('contacto-email').value = d.email || '';
      document.getElementById('contacto-mapa').value = d.mapa || '';
    }
  }

  window.guardarInfoContacto = async function () {
    const data = { direccion: document.getElementById('contacto-direccion').value, celular: document.getElementById('contacto-celular').value, email: document.getElementById('contacto-email').value, mapa: document.getElementById('contacto-mapa').value };
    const res = await apiGet('informacion-contacto');
    const r = (res.success && res.datos.length > 0) ? await apiPut('informacion-contacto', res.datos[0].id, data) : await apiPost('informacion-contacto', data);
    if (r.success) toast('Información guardada','exito'); else toast('Error al guardar','error');
  };

  async function cargarMensajes() {
    const tbody = document.getElementById('mensajes-body'); mostrarCargando(tbody);
    const res = await apiGet('mensajes-contacto');
    if (!res.success || res.datos.length === 0) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-10 font-sans text-text-muted">Sin mensajes</td></tr>'; return; }
    tbody.innerHTML = res.datos.map(m => `<tr class="border-b border-white/5">
      <td class="p-3 font-sans text-white">${m.nombre || '—'}</td>
      <td class="p-3 font-sans text-white/70 text-sm">${m.email || '—'}</td>
      <td class="p-3 font-sans text-white/70 text-sm">${m.telefono || '—'}</td>
      <td class="p-3 font-sans text-white/70 text-sm max-w-[300px] truncate">${m.mensaje || '—'}</td>
    </tr>`).join('');
  }
</script>
