---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin - Servicios" currentSection="servicios">
  <div id="admin-content"><div class="flex flex-col items-center py-20"><div class="spinner mb-4"></div><p class="font-sans text-text-muted">Cargando...</p></div></div>
</AdminLayout>

<script type="module">
  import { STRAPI_URL } from '../../lib/constants';
  const API = STRAPI_URL;
  const norm = (raw) => {
    if (!raw || raw.error || raw.data == null) return { success: false, datos: [], dato: null };
    if (Array.isArray(raw.data)) return { success: true, datos: raw.data, dato: null };
    return { success: true, datos: [raw.data], dato: raw.data };
  };
  const normUpload = (raw) => Array.isArray(raw) && raw.length > 0 ? { success: true, ruta: raw[0].url, id: raw[0].id } : { success: false, ruta: '', id: null };
  const imgUrl = (img) => img?.url ? (img.url.startsWith('http') ? img.url : API + img.url) : null;
  const apiGet = async (t, id, params) => { let url = id ? `${API}/api/${t}/${id}` : `${API}/api/${t}`; if (params) url += '?' + new URLSearchParams(params).toString(); const r = await fetch(url); return norm(await r.json()); };
  const apiPost = async (t, d) => { const r = await fetch(`${API}/api/${t}`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data:d}) }); return norm(await r.json()); };
  const apiPut = async (t, id, d) => { const r = await fetch(`${API}/api/${t}/${id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data:d}) }); return norm(await r.json()); };
  const apiDelete = async (t, id) => { const r = await fetch(`${API}/api/${t}/${id}`, { method:'DELETE' }); return norm(await r.json()); };
  const subirArchivo = async (file) => { const fd = new FormData(); fd.append('files', file); const r = await fetch(`${API}/api/upload`, { method:'POST', body: fd }); return normUpload(await r.json()); };
  const toast = (msg, tipo) => { const c = document.getElementById('toast-container'); if(!c) return; const t = document.createElement('div'); t.className='toast '+tipo; t.textContent=msg; c.appendChild(t); setTimeout(()=>{t.style.opacity='0';setTimeout(()=>t.remove(),300)},3000); };
  const configurarUpload = (inputId, previewId, nombreId, hiddenId) => {
    const input = document.getElementById(inputId); const preview = document.getElementById(previewId); const nombreEl = document.getElementById(nombreId); const hidden = document.getElementById(hiddenId);
    if (!input) return;
    input.addEventListener('change', async () => {
      const file = input.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) { preview.style.display = 'flex'; preview.querySelector('img').src = e.target.result; nombreEl.textContent = file.name; hidden.value = ''; };
      reader.readAsDataURL(file);
      const res = await subirArchivo(file);
      if (res.success) { preview.querySelector('img').src = res.ruta; hidden.value = String(res.id); } else toast('Error al subir imagen', 'error');
    });
  };
  const mostrarCargando = (el) => { el.innerHTML = '<div class="flex flex-col items-center py-10"><div class="spinner mb-4"></div><p class="font-sans text-text-muted">Cargando...</p></div>'; };

  document.getElementById('admin-content').innerHTML = `
    <section>
      <h1 class="font-heading text-3xl text-white mb-2">Administrar Servicios</h1>
      <p class="font-sans text-text-muted mb-8">Administra los servicios que ofrece el hotel.</p>
      <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
        <button class="bg-primary-light text-bg-dark-alt font-sans font-medium border-none rounded-lg px-4 py-2 cursor-pointer flex items-center gap-2" onclick="abrirFormServicio()">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg> Nuevo Servicio
        </button>
        <input type="text" id="servicios-buscar" placeholder="Buscar servicios..." oninput="filtrarTabla('servicios')" class="bg-white/[0.03] border border-white/10 rounded-lg px-4 py-2 text-white font-sans text-sm min-w-[200px] focus:outline-none focus:border-primary" />
      </div>
      <div id="servicios-lista" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8"></div>
      <div id="form-servicio" class="bg-bg-admin rounded-2xl p-6 mb-8 hidden">
        <h2 id="servicio-form-titulo" class="font-heading text-xl text-gold mb-6">Nuevo Servicio</h2>
        <input type="hidden" id="servicio-id" />
        <div class="grid grid-cols-1 gap-4">
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Nombre <span class="text-primary">*</span></label><input type="text" id="servicio-nombre" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary" /></div>
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Descripción</label><textarea id="servicio-descripcion" rows="3" class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-3 text-white font-sans text-sm focus:outline-none focus:border-primary"></textarea></div>
          <div><label class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans">Imagen</label>
            <div class="upload-area border-2 border-dashed border-white/20 rounded-xl p-6 text-center cursor-pointer hover:border-primary" onclick="document.getElementById('servicio-img-input').click()">
              <svg viewBox="0 0 24 24" class="w-10 h-10 fill-text-muted mx-auto mb-2"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
              <p class="font-sans text-white text-sm">Seleccionar imagen</p>
            </div>
            <input type="file" id="servicio-img-input" accept="image/*" class="hidden" />
            <div id="servicio-img-preview" class="hidden mt-3 flex items-center gap-3 bg-white/5 rounded-lg p-3"><img src="" class="w-16 h-16 object-cover rounded" /><div class="flex-1"><p id="servicio-img-nombre" class="font-sans text-white text-sm"></p></div></div>
            <input type="hidden" id="servicio-imagen" />
          </div>
          <div class="flex gap-3"><button class="bg-primary text-black font-sans font-medium border-none rounded-lg px-6 py-3 cursor-pointer hover:bg-primary-dark" onclick="guardarServicio()">Guardar Servicio</button><button class="bg-gray-500 text-white font-sans border-none rounded-lg px-6 py-3 cursor-pointer hover:bg-gray-600" onclick="cerrarFormServicio()">Cancelar</button></div>
        </div>
      </div>
    </section>
  `;
  cargarServicios();

  async function cargarServicios() {
    const lista = document.getElementById('servicios-lista'); mostrarCargando(lista);
    const res = await apiGet('servicios', null, { populate: 'imagen' });
    if (!res.success || res.datos.length === 0) { lista.innerHTML = '<div class="col-span-full text-center py-10 font-sans text-text-muted">Sin servicios registrados</div>'; configurarUpload('servicio-img-input','servicio-img-preview','servicio-img-nombre','servicio-imagen'); return; }
    lista.innerHTML = res.datos.map(s => `<div class="bg-white/5 rounded-xl overflow-hidden">${s.imagen?.url ? `<img src="${imgUrl(s.imagen)}" class="w-full h-40 object-cover" />` : ''}<div class="p-4"><h3 class="font-heading text-white text-lg mb-2">${s.nombre || '—'}</h3><p class="font-sans text-text-muted text-sm mb-3">${s.descripcion || ''}</p><div class="flex gap-2"><button class="bg-blue-500/20 text-blue-400 border-none rounded-lg p-2 cursor-pointer hover:bg-blue-500/30" onclick="editarServicio(${s.id})"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></button><button class="bg-red-500/20 text-red-400 border-none rounded-lg p-2 cursor-pointer hover:bg-red-500/30" onclick="eliminarServicio(${s.id})"><svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button></div></div></div>`).join('');
    configurarUpload('servicio-img-input','servicio-img-preview','servicio-img-nombre','servicio-imagen');
  }

  window.abrirFormServicio = function(data) {
    document.getElementById('form-servicio').classList.remove('hidden');
    document.getElementById('servicio-form-titulo').textContent = data ? 'Editar Servicio' : 'Nuevo Servicio';
    if (data) {
      document.getElementById('servicio-id').value = data.id; document.getElementById('servicio-nombre').value = data.nombre || ''; document.getElementById('servicio-descripcion').value = data.descripcion || '';
      const img = data.imagen;
      document.getElementById('servicio-imagen').value = img?.id || '';
      if (img?.url) { document.getElementById('servicio-img-preview').style.display = 'flex'; document.getElementById('servicio-img-preview').querySelector('img').src = imgUrl(img); document.getElementById('servicio-img-nombre').textContent = img.url.split('/').pop(); }
    } else { ['servicio-id','servicio-nombre','servicio-descripcion','servicio-imagen'].forEach(id => document.getElementById(id).value = ''); document.getElementById('servicio-img-preview').style.display = 'none'; }
    document.getElementById('form-servicio').scrollIntoView({ behavior: 'smooth' });
  };
  window.cerrarFormServicio = function() { document.getElementById('form-servicio').classList.add('hidden'); };
  window.guardarServicio = async function () {
    const id = document.getElementById('servicio-id').value; const imgVal = document.getElementById('servicio-imagen').value; const data = { nombre: document.getElementById('servicio-nombre').value, descripcion: document.getElementById('servicio-descripcion').value, imagen: imgVal ? Number(imgVal) : null };
    if (!data.nombre) { toast('El nombre es requerido','error'); return; }
    const r = id ? await apiPut('servicios', id, data) : await apiPost('servicios', data);
    if (r.success) { toast('Servicio guardado','exito'); cerrarFormServicio(); cargarServicios(); } else toast('Error al guardar','error');
  };
  window.editarServicio = async function(id) { const res = await apiGet('servicios', id, { populate: 'imagen' }); if (res.success) abrirFormServicio(res.dato); };
  window.eliminarServicio = function(id) { window.abrirModalConfirmar('¿Eliminar este servicio?', async () => { const r = await apiDelete('servicios', id); if (r.success) { toast('Servicio eliminado','exito'); cargarServicios(); } else toast('Error al eliminar','error'); }); };
</script>
