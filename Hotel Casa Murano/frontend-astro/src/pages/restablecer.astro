---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Nueva Contraseña | Hotel Casa Murano">
  <div class="flex w-full max-w-5xl min-h-screen max-md:flex-col">
    <div class="w-1/2 flex items-center justify-center bg-gradient-to-br from-primary/20 to-bg-dark p-10 max-md:w-full max-md:p-6">
      <div class="text-center">
        <svg viewBox="0 0 24 24" class="w-20 h-20 fill-primary mx-auto mb-6">
          <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
        </svg>
        <h1 class="font-heading text-4xl text-white leading-tight">Hotel<br />Casa Murano</h1>
        <p class="font-sans text-text-muted text-sm mt-2">Exclusividad. Confort. Experiencia.</p>
      </div>
    </div>

    <div class="w-1/2 flex items-center justify-center p-10 max-md:w-full max-md:p-6">
      <div class="w-full max-w-sm">
        <div class="mb-8">
          <h2 class="font-heading text-2xl text-white mb-2">Restablecer Contraseña</h2>
          <p class="font-sans text-text-muted text-sm">Ingresa la nueva contraseña para tu cuenta de administrador.</p>
        </div>

        <form id="simpleResetForm">
          <div class="mb-6">
            <label for="nuevaContrasena" class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans font-medium">Nueva Contraseña <span class="text-primary">*</span></label>
            <div class="relative flex items-center">
              <input type="password" id="nuevaContrasena" placeholder="Escribe tu nueva clave" required
                class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-[14px_16px_14px_45px] text-white font-sans text-sm transition-all duration-300 focus:outline-none focus:border-primary" />
              <svg class="absolute left-4 w-[18px] h-[18px] fill-text-muted" viewBox="0 0 24 24">
                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
              </svg>
            </div>
          </div>

          <button type="submit" class="w-full bg-primary text-black border-none rounded-lg p-[14px] font-sans text-sm font-medium cursor-pointer transition-all duration-300 hover:bg-primary-dark hover:shadow-[0_5px_15px_rgba(31,214,227,0.3)] active:scale-[0.98]">
            Guardar nueva contraseña
          </button>

          <a href="/login" class="block text-center mt-5 text-sm text-text-muted no-underline transition-colors duration-200 hover:text-primary font-sans">Volver al Login</a>
        </form>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { STRAPI_URL } from '../lib/constants';

  const parametros = new URLSearchParams(window.location.search);
  const token = parametros.get('token');

  if (!token) {
    alert('Enlace de recuperación no válido.');
    window.location.href = '/login';
  }

  (async () => {
    try {
      const respuesta = await fetch(STRAPI_URL + '/validar-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const datos = await respuesta.json();
      if (!datos.success) {
        alert(datos.mensaje || 'Enlace de recuperación no válido o expirado.');
        window.location.href = '/login';
      }
    } catch {
      alert('Error al validar el enlace de recuperación.');
      window.location.href = '/login';
    }
  })();

  document.getElementById('simpleResetForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = document.getElementById('nuevaContrasena').value;
    try {
      const respuesta = await fetch(STRAPI_URL + '/actualizar-clave-directa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, contrasena: password }),
      });
      const datos = await respuesta.json();
      if (datos.success) {
        alert('Contraseña actualizada correctamente.');
        window.location.href = '/login';
      } else {
        alert('No se pudo actualizar: ' + datos.mensaje);
      }
    } catch {
      alert('Error al conectar con el servidor.');
    }
  });
</script>
