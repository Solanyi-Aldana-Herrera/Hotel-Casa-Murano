---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STRAPI_URL } from '../lib/constants';

const API = STRAPI_URL;
const res = await fetch(`${API}/api/nosotros?populate=imagen`);
const json = await res.json();
const data = json?.data || null;

const imgUrl = (img) => {
  if (!img?.url) return null;
  return img.url.startsWith('http') ? img.url : API + img.url;
};

const titulo = data?.titulo || 'Conócenos';
const descripcion = data?.descripcion || '';
const mision = data?.mision || '';
const vision = data?.vision || '';
const heroImg = imgUrl(data?.imagen) || '/images/contenido/Frente de hotel.webp';
---

<BaseLayout title="Nosotros - Hotel Casa Murano" description="Conoce la historia y valores de Hotel Casa Murano">
  <main>

    <!-- HERO -->
    <section class="bg-white pt-24 pb-20 px-4 w-full flex flex-col items-center">
      <div class="max-w-4xl w-full text-center">
        <h3 class="font-decorative text-3xl md:text-4xl text-gold mb-2">Hotel Casa Murano</h3>
        <h1 class="font-heading text-4xl md:text-5xl text-gray-900 mb-10 tracking-wide">{titulo}</h1>
        <div class="w-20 h-0.5 bg-gold/40 mx-auto mb-10"></div>
        <div class="overflow-hidden rounded-lg shadow-md">
          <img src={heroImg} alt="Hotel Casa Murano" class="w-full h-[350px] md:h-[420px] object-cover" />
        </div>
      </div>
    </section>

    <!-- DESCRIPCIÓN -->
    <section class="bg-white pb-20 px-4 w-full flex flex-col items-center">
      <div class="max-w-3xl w-full text-center">
        <p class="font-body text-lg md:text-xl text-gray-600 leading-relaxed">{descripcion}</p>
      </div>
    </section>

    <!-- MISIÓN + VISIÓN + VALORES -->
    <section class="bg-white pb-24 px-4 w-full flex flex-col items-center">
      <div class="max-w-4xl w-full space-y-14">

        <div class="flex items-start gap-8 max-md:flex-col max-md:items-center max-md:text-center">
          <div class="w-20 h-20 shrink-0 rounded-full bg-gold/10 flex items-center justify-center">
            <img src="/images/iconos/icono_mision.png" class="w-11 h-11" />
          </div>
          <div>
            <h4 class="font-heading text-2xl text-gray-900 mb-3">Misión</h4>
            <p class="font-body text-base text-gray-600 leading-relaxed">{mision}</p>
          </div>
        </div>

        <div class="flex items-start gap-8 max-md:flex-col max-md:items-center max-md:text-center">
          <div class="w-20 h-20 shrink-0 rounded-full bg-gold/10 flex items-center justify-center">
            <img src="/images/iconos/icono_vision.png" class="w-11 h-11" />
          </div>
          <div>
            <h4 class="font-heading text-2xl text-gray-900 mb-3">Visión</h4>
            <p class="font-body text-base text-gray-600 leading-relaxed">{vision}</p>
          </div>
        </div>

        <div class="flex items-start gap-8 max-md:flex-col max-md:items-center max-md:text-center">
          <div class="w-20 h-20 shrink-0 rounded-full bg-gold/10 flex items-center justify-center">
            <img src="/images/iconos/icono_valores.png" class="w-11 h-11" />
          </div>
          <div class="flex-1">
            <h4 class="font-heading text-2xl text-gray-900 mb-4">Valores</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Hospitalidad:</strong> Recibimos con calidez, amabilidad y vocación de servicio.</span>
              </div>
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Calidad:</strong> Buscamos la excelencia para brindar confort y satisfacción.</span>
              </div>
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Responsabilidad:</strong> Actuamos con compromiso.</span>
              </div>
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Respeto:</strong> Promovemos relaciones basadas en la cortesía y buen trato.</span>
              </div>
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Innovación:</strong> Buscamos mejorar nuestros servicios y experiencias.</span>
              </div>
              <div class="flex items-start gap-2 max-md:justify-center">
                <span class="text-gold shrink-0">✦</span>
                <span class="font-body text-sm text-gray-600"><strong class="text-gray-800">Sostenibilidad:</strong> Promovemos prácticas responsables con el medio ambiente y la comunidad.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>
