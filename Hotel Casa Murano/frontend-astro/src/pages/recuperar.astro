---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Recuperar Contraseña | Hotel Casa Murano">
  <div class="flex w-full max-w-5xl min-h-screen max-md:flex-col">
    <div class="w-1/2 flex items-center justify-center bg-gradient-to-br from-primary/20 to-bg-dark p-10 max-md:w-full max-md:p-6">
      <div class="text-center">
        <svg viewBox="0 0 24 24" class="w-20 h-20 fill-primary mx-auto mb-6">
          <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
        </svg>
        <h1 class="font-heading text-4xl text-white leading-tight">Hotel<br />Casa Murano</h1>
        <p class="font-sans text-text-muted text-sm mt-2">Exclusividad. Confort. Experiencia.</p>
      </div>
    </div>

    <div class="w-1/2 flex items-center justify-center p-10 max-md:w-full max-md:p-6">
      <div class="w-full max-w-sm">
        <div class="mb-8">
          <h2 class="font-heading text-2xl text-white mb-2">¿Olvidaste tu contraseña?</h2>
          <p class="font-sans text-text-muted text-sm">Introduce tu correo electrónico registrado y te enviaremos las instrucciones para restablecerla.</p>
        </div>

        <form id="recoverForm">
          <div class="mb-6">
            <label for="email" class="block text-xs uppercase tracking-[1.5px] text-text-muted mb-2 font-sans font-medium">Correo Electrónico <span class="text-primary">*</span></label>
            <div class="relative flex items-center">
              <input type="email" id="email" placeholder="tu-correo@hotelcasamurano.com" required autocomplete="email"
                class="w-full bg-white/[0.03] border border-white/10 rounded-lg p-[14px_16px_14px_45px] text-white font-sans text-sm transition-all duration-300 focus:outline-none focus:border-primary" />
              <svg class="absolute left-4 w-[18px] h-[18px] fill-text-muted" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
          </div>

          <button type="submit" class="w-full bg-primary text-black border-none rounded-lg p-[14px] font-sans text-sm font-medium cursor-pointer flex justify-center items-center gap-2.5 mt-[30px] transition-all duration-300 hover:bg-primary-dark hover:shadow-[0_5px_15px_rgba(31,214,227,0.3)] active:scale-[0.98]">
            Enviar enlace de recuperación
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-black">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </button>

          <a href="/login" class="block text-center mt-5 text-sm text-text-muted no-underline transition-colors duration-200 hover:text-primary font-sans">Volver al inicio de sesión</a>
        </form>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { STRAPI_URL } from '../lib/constants';

  document.getElementById('recoverForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    try {
      const respuesta = await fetch(STRAPI_URL + '/recuperar-contrasena', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const datos = await respuesta.json();
      if (datos.success) {
        alert('Se ha enviado un correo con las instrucciones para restablecer tu contraseña.');
        window.location.href = '/login';
      } else {
        alert(datos.mensaje || 'El correo ingresado no está registrado.');
      }
    } catch {
      alert('No se pudo conectar con el servidor. Inténtalo más tarde.');
    }
  });
</script>
