---

---

<section class="hero-section relative min-h-screen w-full bg-black overflow-hidden flex items-center justify-center">
  <div id="slider-container" class="absolute inset-0 z-0 overflow-hidden"></div>

  <div class="relative z-10 flex flex-col items-center justify-center w-full px-4 md:px-8 pt-20 md:pt-0">
    <div class="text-center">
      <h1 id="slider-titulo" class="font-headingCr text-5xl md:text-6xl tracking-[5px] text-white leading-tight">HOTEL</h1>
      <h2 id="slider-descripcion" class="font-heading text-3xl md:text-4xl tracking-[5px] text-white leading-tight">CASA MURANO</h2>
    </div>

    <div class="mt-28 md:mt-56 w-full flex justify-center">
      <div id="reserva-box" class="w-full max-w-[900px] flex flex-wrap items-center justify-center gap-3 md:gap-4 bg-white/10 backdrop-blur-sm px-4 md:px-8 py-3 md:py-2.5 rounded-3xl md:rounded-[70px] border-[3px] border-primary-light shadow-lg">
        <div class="flex flex-wrap items-center justify-center gap-2 md:gap-4 px-3 md:px-8 py-2 md:py-2.5 border-2 border-primary-light rounded-2xl md:rounded-3xl">
          <div class="campo cursor-pointer flex flex-col items-center min-w-20" onclick="document.getElementById('input-entrada').showPicker()">
            <span class="font-body text-xs md:text-sm text-primary-light font-bold leading-none tracking-[1px] mb-1">Entrada</span>
            <div class="fecha-display flex flex-col items-center text-white font-heading leading-[1.2]">
              <p id="dia-entrada" class="text-2xl md:text-4xl m-0 font-normal"></p>
              <span id="mes-entrada" class="text-xs md:text-sm -mt-1 capitalize"></span>
            </div>
            <input type="date" id="input-entrada" class="absolute opacity-0 w-0 h-0 pointer-events-none" />
          </div>

          <div class="campo cursor-pointer flex flex-col items-center min-w-20" onclick="document.getElementById('input-salida').showPicker()">
            <span class="font-body text-xs md:text-sm text-primary-light font-bold leading-none tracking-[1px] mb-1">Salida</span>
            <div class="fecha-display flex flex-col items-center text-white font-heading leading-[1.2]">
              <p id="dia-salida" class="text-2xl md:text-4xl m-0 font-normal"></p>
              <span id="mes-salida" class="text-xs md:text-sm -mt-1 capitalize"></span>
            </div>
            <input type="date" id="input-salida" class="absolute opacity-0 w-0 h-0 pointer-events-none" />
          </div>
        </div>

        <div class="campo flex flex-col items-center relative">
          <span class="font-body text-xs md:text-sm text-primary-light font-bold leading-none tracking-[1px] mb-1">Ocupación</span>
          <div class="ocupacion-selector cursor-pointer" onclick="toggleOcupacion()">
            <div class="flex items-center gap-1.5 md:gap-2 justify-center">
              <div class="size-7 md:size-9 flex justify-center items-center">
                <img src="/images/iconos/Adulto.png" alt="Adulto" class="max-w-full max-h-full object-contain" />
              </div>
              <span id="num-adultos" class="font-heading text-xl md:text-2xl text-white md:mr-[10px]">1</span>
              <div class="size-7 md:size-9 flex justify-center items-center">
                <img src="/images/iconos/Niño.png" alt="Niño" class="max-w-full max-h-full object-contain" />
              </div>
              <span id="num-ninos" class="font-heading text-xl md:text-2xl text-white md:mr-[10px]">1</span>
            </div>
          </div>
          <div id="dropdown-ocupacion" class="hidden absolute bg-white rounded-xl p-4 shadow-lg z-50 bottom-full mb-2 left-1/2 -translate-x-1/2 min-w-44">
            <div class="flex justify-between items-center mb-1 text-black font-heading">
              <span class="text-sm">Adultos</span>
              <input type="number" id="cant-adultos" value="1" min="1" class="w-11 text-center border border-gray-300 rounded px-1 py-0.5 text-sm" oninput="actualizarOcupacion()" />
            </div>
            <div class="flex justify-between items-center mb-1 text-black font-heading">
              <span class="text-sm">Niños</span>
              <input type="number" id="cant-ninos" value="1" min="0" class="w-11 text-center border border-gray-300 rounded px-1 py-0.5 text-sm" oninput="actualizarOcupacion()" />
            </div>
            <button class="w-full bg-primary-light border-none py-2 rounded-xl font-heading text-xs cursor-pointer mt-2" onclick="toggleOcupacion()">Listo</button>
          </div>
        </div>

        <button class="bg-primary-light text-bg-dark-alt font-body text-lg md:text-xl border-none px-5 md:px-6 py-2 md:py-2.5 rounded-[35px] cursor-pointer transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_white] hover:text-black" onclick="irAReserva()">
          RESERVA
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { STRAPI_URL } from '../../lib/constants';

  const imgUrl = (img) => img?.url ? (img.url.startsWith('http') ? img.url : STRAPI_URL + img.url) : null;

  function normalizeList(raw) {
    if (!raw || raw.error || !raw.data) return [];
    return Array.isArray(raw.data) ? raw.data : [raw.data];
  }

  async function cargarSlider() {
    try {
      const res = await fetch(STRAPI_URL + '/api/slider-inicios?populate=imagen');
      const activos = normalizeList(await res.json())
        .filter(s => s.activo)
        .sort((a, b) => (a.orden_slider || 0) - (b.orden_slider || 0));

      if (activos.length > 0) {
        const container = document.getElementById('slider-container');
        container.innerHTML = activos.map((s, i) =>
          '<div class="slide' + (i === 0 ? ' active' : '') + '">' +
            '<img src="' + imgUrl(s.imagen) + '" alt="Hotel ' + (i + 1) + '">' +
          '</div>'
        ).join('');

        const tituloEl = document.getElementById('slider-titulo');
        const descEl = document.getElementById('slider-descripcion');

        function actualizarTextoSlide(idx) {
          const s = activos[idx];
          if (tituloEl) tituloEl.textContent = s.titulo || 'HOTEL';
          if (descEl) descEl.textContent = s.descripcion || 'CASA MURANO';
        }

        actualizarTextoSlide(0);

        const slides = container.querySelectorAll('.slide');
        if (slides.length > 1) {
          let index = 0;
          setInterval(() => {
            slides[index]?.classList.remove('active');
            index = (index + 1) % slides.length;
            slides[index]?.classList.add('active');
            actualizarTextoSlide(index);
          }, 5000);
        }
      }
    } catch (e) {
      console.warn('No se pudieron cargar las imágenes del slider');
    }
  }

  cargarSlider();
</script>
