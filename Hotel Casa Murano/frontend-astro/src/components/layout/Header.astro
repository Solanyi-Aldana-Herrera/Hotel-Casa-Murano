---
import { NAV_LINKS } from '../../lib/constants';
---

<header id="header" class="sticky top-0 w-full z-50 bg-bg-form transition-colors duration-300">
  <div class="flex items-center w-full max-w-[1500px] h-[115px] mx-auto px-4 max-lg:px-4 max-lg:min-h-[115px]">
    <div class="logo">
      <a href="/" class="inline-block transition-transform duration-300 hover:scale-110">
        <img src="/images/logo/LogoConNombre.png" alt="Hotel Casa Murano" class="h-[72px] w-auto max-lg:h-[55px]" />
      </a>
    </div>

    <nav class="ml-[150px] flex-grow max-lg:ml-auto max-lg:flex max-lg:items-center" id="navbar">
      <button
        id="hamburger"
        class="hidden flex-col cursor-pointer gap-[5px] p-1 bg-transparent border-none max-lg:flex"
        aria-label="Menú"
      >
        <span class="block w-7 h-0.5 bg-white rounded transition-all duration-300"></span>
        <span class="block w-7 h-0.5 bg-white rounded transition-all duration-300"></span>
        <span class="block w-7 h-0.5 bg-white rounded transition-all duration-300"></span>
      </button>

      <ul id="nav-links" class="flex items-center justify-end gap-[23px] m-0 p-0 max-lg:hidden max-lg:flex-col max-lg:absolute max-lg:top-[115px] max-lg:left-0 max-lg:w-full max-lg:bg-bg-form max-lg:p-5 max-lg:gap-2.5 max-lg:z-[999]">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-white font-heading text-[22.3px] px-4 py-2 inline-block relative transition-colors duration-300 hover:text-primary-light max-lg:text-lg max-lg:text-center max-lg:w-full after:content-[''] after:absolute after:left-1/2 after:-bottom-0 after:w-0 after:h-0.5 after:bg-primary-light after:transition-all after:duration-300 after:-translate-x-1/2 hover:after:w-[70%]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            onclick="window.location.href='/reserva'"
            class="bg-primary-light text-bg-dark-alt font-body text-[22.3px] border-none px-4 py-2 rounded-[35px] cursor-pointer transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_white] hover:text-black"
          >
            RESERVA
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      navLinks.classList.toggle('show');
      const spans = hamburger.querySelectorAll('span');
      if (hamburger.classList.contains('active')) {
        spans[0].style.transform = 'rotate(45deg) translate(5px, 6px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translate(5px, -6px)';
      } else {
        spans[0].style.transform = '';
        spans[1].style.opacity = '';
        spans[2].style.transform = '';
      }
    });
    if (navLinks.classList.contains('show')) {
      navLinks.classList.remove('show');
    }
  }

</script>

<style>
  #nav-links.show {
    display: flex !important;
  }
  @media (max-width: 992px) {
    #hamburger { display: flex; }
    #nav-links { display: none; }
  }
</style>
