---
export interface Props {
  sections: Array<{ id: string; label: string }>;
  current?: string;
}

const { sections, current } = Astro.props;
---

<aside class="w-[260px] bg-bg-admin text-white p-[30px_20px] flex flex-col max-md:w-full max-md:p-4">
  <div class="mb-10 text-center">
    <a href="/" class="inline-block">
      <img src="/images/logo/LogoConNombre.png" alt="Hotel Casa Murano" class="h-[90px] w-auto" />
    </a>
  </div>

  <ul class="list-none m-0 p-0 flex-1">
    {
      sections.map((sec) => (
        <li class="mb-3">
          <a
            href={sec.id === 'inicio' ? '/admin' : `/admin/${sec.id}`}
            class={
              'w-full block px-3.5 py-3.5 no-underline text-white rounded-xl transition-colors duration-300 text-base font-heading ' +
              ((current === sec.id || (!current && sec.id === 'inicio'))
                ? 'bg-gold'
                : 'bg-[#222] hover:bg-gold')
            }
          >
            {sec.label}
          </a>
        </li>
      ))
    }
  </ul>
</aside>
